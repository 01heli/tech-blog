# Database (SQLite file path, relative to prisma/ directory)
DATABASE_URL="file:./data/blog.db"

# iron-session encryption secret (generate with: openssl rand -base64 32)
SESSION_SECRET="replace-with-32-byte-base64-secret"

# Alibaba Cloud SMS credentials
ALIBABA_ACCESS_KEY_ID="your-access-key-id"
ALIBABA_ACCESS_KEY_SECRET="your-access-key-secret"
ALIBABA_SMS_SIGN_NAME="鹤唳"
ALIBABA_SMS_TEMPLATE_CODE="SMS_123456789"

# Admin phone for seeding (E.164 format: +8613800000000)
ADMIN_PHONE="+8613800000000"

# Set to "true" to mock SMS (print code to console instead of sending)
SMS_MOCK="true"
